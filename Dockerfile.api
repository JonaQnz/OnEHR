# syntax=docker/dockerfile:1.7

# Base deps stage
FROM node:18-slim AS deps
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Copy only the files needed for npm ci
COPY package.json package-lock.json ./
COPY packages/core/package.json ./packages/core/
COPY packages/openehr-engine/package.json ./packages/openehr-engine/
COPY packages/react-form-builder2/package.json ./packages/react-form-builder2/
COPY packages/plugin-api/package.json ./packages/plugin-api/
COPY packages/example-vitals-plugin/package.json ./packages/example-vitals-plugin/
COPY packages/example-n8n-plugin/package.json ./packages/example-n8n-plugin/
COPY packages/aql-prefill-plugin/package.json ./packages/aql-prefill-plugin/
COPY packages/formbuilder-plugin-iframe/package.json ./packages/formbuilder-plugin-iframe/
COPY packages/postal-lookup-plugin/package.json ./packages/postal-lookup-plugin/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN --mount=type=cache,target=/root/.npm npm ci

# Builder stage
FROM node:18-slim AS build
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Copy dependencies
COPY --from=deps /app ./

# Copy source code
COPY . .

# Generate Prisma and build
RUN cd apps/api && npx prisma generate
RUN npm run build:packages
RUN cd apps/api && npm run build

# Runtime stage
FROM node:18-slim AS runtime
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Copy everything necessary from build
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/core ./packages/core
COPY --from=build /app/packages/openehr-engine ./packages/openehr-engine
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/packages/plugin-api ./packages/plugin-api
COPY --from=build /app/packages/example-vitals-plugin ./packages/example-vitals-plugin
COPY --from=build /app/packages/example-n8n-plugin ./packages/example-n8n-plugin
COPY --from=build /app/packages/aql-prefill-plugin ./packages/aql-prefill-plugin
COPY --from=build /app/packages/formbuilder-plugin-iframe ./packages/formbuilder-plugin-iframe
COPY --from=build /app/packages/postal-lookup-plugin ./packages/postal-lookup-plugin
COPY --from=build /app/package.json ./

EXPOSE 3001
CMD ["sh", "-c", "cd apps/api && npx prisma db push --schema=prisma/schema.prisma && node dist/index.js"]
