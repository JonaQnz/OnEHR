# Dependency directories
node_modules/

# Production build outputs
dist/
dist-ssr/
lib/

# Local env files (credentials/secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Runtime data directory - the api service's docker-compose bind mount
# (DATA_DIR=/app/data), holding mutable local state (config.json with
# credentials, uploaded assets, ...). Never meant to be version controlled.
# Root-anchored (leading /) so this doesn't also match an unrelated data/
# directory elsewhere in the tree (e.g. apps/data/config.json is its own,
# intentionally tracked file).
/data/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Claude Code agent worktree scratch state
.claude/worktrees/
