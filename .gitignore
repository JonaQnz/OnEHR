# Dependency directories
node_modules/

# Production build outputs
dist/
dist-ssr/
lib/

# Local env files (credentials/secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Runtime configuration and data - never version controlled. Secrets come
# from environment variables (apps/api/.env.example) or an untracked local
# config.json (copy apps/data/config.example.json to apps/data/config.json).
# /data/ is the api service's docker-compose bind mount (DATA_DIR=/app/data).
# .data uses a file-level pattern on purpose: ignoring the directory itself
# breaks staging the deletion of files that used to be tracked in it.
/data/
/.data/*
**/data/config.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Claude Code agent worktree scratch state
.claude/worktrees/
# AI Dev Home: secrets and runtime files stay out of Git
.env.*
!.env.example
*.pem
*.key
__pycache__/
.venv/
.omc/
.pytest_cache/
