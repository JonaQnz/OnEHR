generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Form {
  id             String        @id @default(uuid())
  parent_id      String?
  name           String
  version        String
  status         String
  canonical_json Json
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  fhirMappings   FhirMapping[]

  @@map("forms")
}

model Template {
  id                   String   @id @default(uuid())
  template_id          String
  version              String
  type                 String
  alias                String
  parsed_registry_json Json
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("templates")
}

model FhirCatalog {
  id           String   @id @default(uuid())
  name         String
  fhir_version String
  catalog_json Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("fhir_catalogs")
}

model FhirMapping {
  id           String   @id @default(uuid())
  form_id      String
  field_name   String
  mapping_json Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  form Form @relation(fields: [form_id], references: [id], onDelete: Cascade)

  @@map("fhir_mappings")
}
