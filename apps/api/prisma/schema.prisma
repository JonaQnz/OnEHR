generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Form {
  id             String        @id @default(uuid())
  parent_id      String?
  name           String
  version        String
  status         String
  canonical_json Json
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("forms")
}

model Template {
  id                   String   @id @default(uuid())
  template_id          String
  version              String
  type                 String
  alias                String
  parsed_registry_json Json
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("templates")
}

enum FormSessionMode {
  create
  edit
  view
  prefill
}

enum FormSessionStatus {
  draft
  in_progress
  ready
  submitted
  failed
  cancelled
}

model FormSession {
  id                 String   @id @default(uuid())
  formId             String   @map("form_id")
  formVersion        String   @map("form_version")
  mode               FormSessionMode @default(create)
  patientId          String   @map("patient_id")
  patientNamespace   String?  @map("patient_namespace")
  userId             String   @map("user_id")
  authMode           String   @map("auth_mode")
  status             FormSessionStatus @default(draft)
  values             Json
  validation         Json
  runtimeContext     Json     @default("{}") @map("runtime_context")
  revision           Int      @default(0)
  providerId         String?  @map("provider_id")
  providerReference  String?  @map("provider_reference")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([formId])
  @@index([userId])
  @@map("form_sessions")
}

model AqlFunction {
  id          String   @id @default(uuid())
  packageName String   @map("package_name")
  name        String
  description String   @default("")
  query       String
  parameters  Json     @default("{}")
  autoload    Boolean  @default(true)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([packageName, name])
  @@index([enabled, autoload])
  @@map("aql_functions")
}

model CodeFunction {
  id          String   @id @default(uuid())
  packageName String   @map("package_name")
  name        String
  description String   @default("")
  source      String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([packageName, name])
  @@index([enabled])
  @@map("code_functions")
}

model Patient {
  id               String   @id @default(uuid())
  patientId        String   @map("patient_id")
  patientNamespace String   @map("patient_namespace")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  birthDate        String?  @map("birth_date")
  gender           String?
  ehrId            String   @unique @map("ehr_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([patientNamespace, patientId])
  @@map("patients")
}

enum UserStatus {
  active
  inactive
}

enum ApplicationRole {
  USER
  ADMIN
}

model ApplicationUser {
  id           String      @id @default(uuid())
  username     String?     @unique
  displayName  String?     @map("display_name")
  email        String?
  passwordHash String?     @map("password_hash")
  status       UserStatus  @default(active)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  lastLoginAt  DateTime?   @map("last_login_at")
  roles        RoleAssignment[]
  identities   IdentityLink[]
  sessions     ApplicationSession[]
  auditEvents  AuditEvent[] @relation("AuditActor")

  @@map("application_users")
}

model RoleAssignment {
  userId String          @map("user_id")
  role   ApplicationRole
  user   ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("role_assignments")
}

model IdentityLink {
  id              String          @id @default(uuid())
  issuer          String
  externalSubject String          @map("external_subject")
  localUserId     String          @map("local_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  lastSeenAt      DateTime        @default(now()) @map("last_seen_at")
  user            ApplicationUser @relation(fields: [localUserId], references: [id], onDelete: Cascade)

  @@unique([issuer, externalSubject])
  @@index([localUserId])
  @@map("identity_links")
}

model ApplicationSession {
  id         String          @id
  userId     String          @map("user_id")
  expiresAt  DateTime        @map("expires_at")
  revokedAt  DateTime?       @map("revoked_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  lastSeenAt DateTime        @default(now()) @map("last_seen_at")
  user       ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("application_sessions")
}

model AuditEvent {
  id          String           @id @default(uuid())
  actorUserId String?          @map("actor_user_id")
  action      String
  resourceType String           @map("resource_type")
  resourceId  String?          @map("resource_id")
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at")
  actor       ApplicationUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@map("audit_events")
}
