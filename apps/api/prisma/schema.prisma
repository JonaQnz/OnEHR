generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Form {
  id             String        @id @default(uuid())
  parent_id      String?
  name           String
  version        String
  status         String
  canonical_json Json
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("forms")
}

model Template {
  id                   String   @id @default(uuid())
  template_id          String
  version              String
  type                 String
  alias                String
  parsed_registry_json Json
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("templates")
}

model FormSession {
  id                 String   @id @default(uuid())
  formId             String   @map("form_id")
  formVersion        String   @map("form_version")
  mode               String   @default("create")
  patientId          String   @map("patient_id")
  patientNamespace   String?  @map("patient_namespace")
  userId             String   @map("user_id")
  authMode           String   @map("auth_mode")
  status             String   @default("draft")
  values             Json
  validation         Json
  revision           Int      @default(0)
  providerId         String?  @map("provider_id")
  providerReference  String?  @map("provider_reference")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([formId])
  @@index([userId])
  @@map("form_sessions")
}

model Patient {
  id               String   @id @default(uuid())
  patientId        String   @map("patient_id")
  patientNamespace String   @map("patient_namespace")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  birthDate        String?  @map("birth_date")
  gender           String?
  ehrId            String   @unique @map("ehr_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([patientNamespace, patientId])
  @@map("patients")
}
