generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Form {
  id             String        @id @default(uuid())
  parent_id      String?
  name           String
  version        String
  status         String
  canonical_json Json
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("forms")
}

model Template {
  id                   String   @id @default(uuid())
  template_id          String
  version              String
  type                 String
  alias                String
  parsed_registry_json Json
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("templates")
}


