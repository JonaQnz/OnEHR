generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Form {
  id             String        @id @default(uuid())
  parent_id      String?
  name           String
  version        String
  status         String
  canonical_json Json
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("forms")
}

model Template {
  id                   String   @id @default(uuid())
  template_id          String
  version              String
  type                 String
  alias                String
  parsed_registry_json Json
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("templates")
}

enum FormSessionMode {
  create
  edit
  view
  prefill
}

enum FormSessionStatus {
  draft
  in_progress
  ready
  submitted
  failed
  cancelled
}

enum CompositionSessionStatus {
  draft
  in_progress
  ready
  submitted
  failed
  cancelled
}

model CompositionSession {
  id                 String                   @id @default(uuid())
  compositionFormId  String                   @map("composition_form_id")
  compositionVersion String                   @map("composition_version")
  patientId          String                   @map("patient_id")
  patientNamespace   String?                  @map("patient_namespace")
  ehrId              String?                  @map("ehr_id")
  userId             String                   @map("user_id")
  authMode           String                   @map("auth_mode")
  mode               FormSessionMode          @default(create)
  status             CompositionSessionStatus @default(draft)
  // Block id -> child FormSession id. Values remain in the child session.
  childSessions      Json                     @default("{}") @map("child_sessions")
  revision           Int                      @default(0)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@index([compositionFormId, patientId])
  @@index([userId, updatedAt])
  @@map("composition_sessions")
}

model FormSession {
  id                 String   @id @default(uuid())
  formId             String   @map("form_id")
  formVersion        String   @map("form_version")
  mode               FormSessionMode @default(create)
  patientId          String   @map("patient_id")
  patientNamespace   String?  @map("patient_namespace")
  userId             String   @map("user_id")
  authMode           String   @map("auth_mode")
  status             FormSessionStatus @default(draft)
  values             Json
  validation         Json
  runtimeContext     Json     @default("{}") @map("runtime_context")
  revision           Int      @default(0)
  providerId         String?  @map("provider_id")
  providerReference  String?  @map("provider_reference")
  // This session's OWN self-created draft composition on the provider, set
  // only by autosaveFormSessionDraft - distinct from providerReference,
  // which for a prefill-mode session is the SOURCE composition it copied
  // from and must never be silently overwritten. submitFormSessionToProvider
  // prefers this over providerReference precisely so a create/prefill-mode
  // session that's been autosaving keeps updating its own draft instead of
  // creating a second, disconnected composition at final submit.
  draftReference     String?  @map("draft_reference")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([formId])
  @@index([userId])
  @@map("form_sessions")
}

// A reference to a query defined on EHRbase's own openEHR Query Service
// (/definition/query), not a container for AQL text of our own. `query`
// and `ehrbaseVersion` are a read-through cache of what EHRbase actually
// has stored under `packageName::name` - refreshed from there on every
// list - so the real (immutable, versioned, non-deletable) definition on
// EHRbase stays the single source of truth. See aqlFunctionService.ts.
model AqlFunction {
  id             String   @id @default(uuid())
  packageName    String   @map("package_name")
  name           String
  description    String   @default("")
  query          String
  ehrbaseVersion String?  @map("ehrbase_version")
  parameters     Json     @default("{}")
  autoload       Boolean  @default(true)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([packageName, name])
  @@index([enabled, autoload])
  @@map("aql_functions")
}

model DataWidget {
  id            String   @id @default(uuid())
  name          String
  description   String   @default("")
  aqlFunctionId String   @map("aql_function_id")
  configuration Json     @default("{}")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([aqlFunctionId, enabled])
  @@map("data_widgets")
}

model CodeFunction {
  id          String   @id @default(uuid())
  packageName String   @map("package_name")
  name        String
  description String   @default("")
  source      String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([packageName, name])
  @@index([enabled])
  @@map("code_functions")
}

model Patient {
  id               String        @id @default(uuid())
  patientId        String        @map("patient_id")
  patientNamespace String        @map("patient_namespace")
  firstName        String        @map("first_name")
  lastName         String        @map("last_name")
  birthDate        String?       @map("birth_date")
  gender           String?
  ehrId            String        @unique @map("ehr_id")
  // Where this record came from: "native" was created here in Forms
  // (create_patient / the "Patient anlegen" button); "imported" was
  // discovered on EHRbase (an EHR with no Forms-authored data behind it
  // yet) by syncPatientsFromEhrbase. An imported patient flips to native
  // the moment a form is actually added for them (createFormSession) -
  // it never flips back the other way.
  origin           PatientOrigin @default(native)
  // Whether syncPatientsFromEhrbase last found a real openEHR-EHR-CLUSTER.
  // person.v1 (vg_Person template) composition for this EHR - i.e. whether
  // firstName/lastName/birthDate/gender above are genuine EHRbase data or
  // just a placeholder ("Unbekannt"). Drives the "needs assignment" split
  // in the Patient overview; re-evaluated (and can flip back to false, e.g.
  // a template rename) on every sync, unlike origin.
  hasPersonArchetype Boolean      @default(false) @map("has_person_archetype")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@unique([patientNamespace, patientId])
  @@map("patients")
}

enum PatientOrigin {
  native
  imported
}

enum UserStatus {
  active
  inactive
}

enum ApplicationRole {
  USER
  ADMIN
}

model ApplicationUser {
  id           String      @id @default(uuid())
  username     String?     @unique
  displayName  String?     @map("display_name")
  email        String?
  passwordHash String?     @map("password_hash")
  status       UserStatus  @default(active)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  lastLoginAt  DateTime?   @map("last_login_at")
  roles        RoleAssignment[]
  identities   IdentityLink[]
  sessions     ApplicationSession[]
  auditEvents  AuditEvent[] @relation("AuditActor")

  @@map("application_users")
}

model RoleAssignment {
  userId String          @map("user_id")
  role   ApplicationRole
  user   ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("role_assignments")
}

model IdentityLink {
  id              String          @id @default(uuid())
  issuer          String
  externalSubject String          @map("external_subject")
  localUserId     String          @map("local_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  lastSeenAt      DateTime        @default(now()) @map("last_seen_at")
  user            ApplicationUser @relation(fields: [localUserId], references: [id], onDelete: Cascade)

  @@unique([issuer, externalSubject])
  @@index([localUserId])
  @@map("identity_links")
}

model ApplicationSession {
  id         String          @id
  userId     String          @map("user_id")
  expiresAt  DateTime        @map("expires_at")
  revokedAt  DateTime?       @map("revoked_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  lastSeenAt DateTime        @default(now()) @map("last_seen_at")
  user       ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("application_sessions")
}

model AuditEvent {
  id          String           @id @default(uuid())
  actorUserId String?          @map("actor_user_id")
  action      String
  resourceType String           @map("resource_type")
  resourceId  String?          @map("resource_id")
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at")
  actor       ApplicationUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@map("audit_events")
}
