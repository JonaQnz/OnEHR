# Copy this file to apps/api/.env and fill in your own values.
# Never commit .env; secrets stay empty here.

# PostgreSQL connection string for Prisma, e.g. postgresql://localhost:5432/forms (add user/password only in your local .env)
DATABASE_URL=
# HTTP port the API listens on
PORT=
# Allowed web origin for CORS
WEB_ORIGIN=
# Directory of the runtime config.json
DATA_DIR=
# Base URL of the EHRbase REST API
EHRBASE_URL=http://localhost:8080/ehrbase/rest/openehr/v1
# EHRbase username
EHRBASE_USER=
# EHRbase password
EHRBASE_PASS=
# Authentication mode against EHRbase
AUTH_MODE=basic
# Keycloak REST API base URL
KEYCLOAK_API=
# Keycloak tenant (realm) name
KEYCLOAK_TENANT_NAME=
# Keycloak client id
KEYCLOAK_CLIENT_ID=
# Keycloak grant type
KEYCLOAK_GRANT_TYPE=password
# EHRbase subject namespace
EHRBASE_SUBJECT_NAMESPACE=default
# Default EHR id used when none is given
DEFAULT_EHR_ID=
# Base URL of the mapping service
MAPPING_SERVICE_API=
# Application user authentication mode
USER_AUTH_MODE=local
# Session lifetime in minutes
SESSION_LIFETIME_MINUTES=
# Local auth username
LOCAL_AUTH_USERNAME=
# Local auth password
LOCAL_AUTH_PASSWORD=
# Bootstrap admin username
FORMS_BOOTSTRAP_ADMIN_USERNAME=
# Bootstrap admin password
FORMS_BOOTSTRAP_ADMIN_PASSWORD=
# Bootstrap admin display name
FORMS_BOOTSTRAP_ADMIN_DISPLAY_NAME=
# Bootstrap admin e-mail
FORMS_BOOTSTRAP_ADMIN_EMAIL=
# Comma-separated e-mails granted HIP admin access
FORMS_HIP_ADMIN_EMAILS=
# Mark the session cookie as secure (true/false)
SESSION_COOKIE_SECURE=false
# Base URL of the form-script AI
FORM_SCRIPT_AI_BASE_URL=
# API key for the form-script AI
FORM_SCRIPT_AI_API_KEY=
# Model name for the form-script AI
FORM_SCRIPT_AI_MODEL=
# API key for the form-script AI (OPENAI_API_KEY is the fallback)
OPENAI_API_KEY=
# Base URL of the FHIR CDR
FHIR_CDR_URL=
# Comma-separated plugin packages
FORM_BUILDER_PLUGINS=
