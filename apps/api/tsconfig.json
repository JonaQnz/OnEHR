{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "../..",
    "paths": {
      "core": ["packages/core/dist"],
      "openehr-engine": ["packages/openehr-engine/dist"],
      "plugin-api": ["packages/plugin-api/dist"]
    }
  },
  "include": ["src/**/*"]
}
