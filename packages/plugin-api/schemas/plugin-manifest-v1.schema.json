{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openehr-formbuilder.dev/schemas/plugin-manifest-v1.schema.json",
  "title": "Form Builder Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "apiVersion", "name", "extensionPoints"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": { "type": "string", "minLength": 1 },
    "apiVersion": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "extensionPoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["settings", "field", "form", "renderer", "designer", "runtime", "dataProvider", "workflow", "lifecycle"]
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["form:read", "form:write", "patient:read", "ehrbase:read", "ehrbase:write", "network:request"]
      }
    }
  }
}
